---
import {
  ArrowRight,
  CircleHelp,
  Mail,
} from '@lucide/astro';

interface Props { name: string; size?: number; strokeWidth?: number; class?: string }
const { name, size = 20, strokeWidth = 1.9, class: className } = Astro.props;

const icons = {
  arrowRight: ArrowRight,
  mail: Mail,
} as const;
const Component = icons[name as keyof typeof icons] ?? CircleHelp;
---
<Component size={size} stroke-width={strokeWidth} class={className} aria-hidden="true" focusable="false" />
